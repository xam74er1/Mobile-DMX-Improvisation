{
  "expo": {
    "name": "DMX Improvisator",
    "slug": "mobile-dmx-improvisator",
    "version": "1.0.0",
    "scheme": "dmximprovisator",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dmximprovisator.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.dmximprovisator.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single-page",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
